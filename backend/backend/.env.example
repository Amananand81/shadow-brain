NODE_ENV=development
PORT=8000

MONGODB_URI=mongodb://user:password@localhost:27017/brain-shadow?authSource=admin

AI_PROVIDER=groq
# Two separate Groq keys, one per workload, so each gets its own
# 14,400 req/day quota instead of sharing one. Both fall back to
# GROQ_API_KEY (single-key) if their specific var isn't set.
GROQ_API_KEY_SUMMARY=your-groq-api-key-for-enrichment
GROQ_API_KEY_CHAT=your-groq-api-key-for-search-chat
# GROQ_API_KEY=your-groq-api-key
CEREBRAS_API_KEY=your-cerebras-api-key
BACKEND_API_KEY=change-this-secret
LOG_LEVEL=info


JWT_SECRET=generate-a-long-random-secret
# Keep this secret server-side and pair it with the frontend publishable key.
CLERK_SECRET_KEY=sk_test_your-secret-key
# Comma-separated frontend origins authorized to exchange Clerk session tokens.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# n8n integration — Search-based journey summary
# Set this to your n8n webhook URL to enable the n8n journey summary workflow.
# If unset, the search summary falls back to direct Groq API calls (existing behaviour).
N8N_SUMMARY_WEBHOOK_URL=http://localhost:5678/webhook/brain-shadow-summary

FRONTEND_URL=http://localhost:3000
