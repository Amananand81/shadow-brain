NODE_ENV=development
PORT=8000

MONGODB_URI=mongodb://user:password@localhost:27017/brain-shadow?authSource=admin

AI_PROVIDER=groq
# Two separate Groq keys, one per workload, so each gets its own
# 14,400 req/day quota instead of sharing one. Both fall back to
# GROQ_API_KEY (single-key) if their specific var isn't set.
GROQ_API_KEY_SUMMARY=your-groq-api-key-for-enrichment
GROQ_API_KEY_CHAT=your-groq-api-key-for-search-chat
# GROQ_API_KEY=your-groq-api-key
CEREBRAS_API_KEY=your-cerebras-api-key
BACKEND_API_KEY=change-this-secret
LOG_LEVEL=info

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
JWT_SECRET=generate-a-long-random-secret
# Optional development-only demo auth secret. Leave unset outside local testing.
DEMO_JWT_SECRET=generate-a-separate-random-demo-secret
FRONTEND_URL=http://localhost:3000
JJ_EMAIL=your-sending-email@gmail.com
JJ_EMAIL_PASS=your-16-character-gmail-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
